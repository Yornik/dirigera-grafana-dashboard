          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "(max by (sensor, room) (max_over_time(ikea_illuminance_lux{room=~\"$room\"}[$__interval]))) and on() (time() - max(ikea_dirigera_last_success_timestamp_seconds) < 300)",
          "refId": "A",
          "instant": false,
          "range": true,
          "legendFormat": "{{room}} · {{sensor}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "row",
      "title": "Batteries and connection",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "panels": []
    },
    {
      "id": 10,
      "type": "state-timeline",
      "title": "Battery over time",
      "description": "One row for each remote control and motion sensor. Gray: above 30 %. Yellow: 30 % or less. Red: 15 % or less, replace or charge it. A gap means the hub could not reach the device.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#8a8a8a"
          },
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": null,
                "to": 15,
                "result": {
                  "text": "Replace",
                  "color": "#d03b3b",
                  "index": 0
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 15.0001,
                "to": 30,
                "result": {
                  "text": "Low",
                  "color": "#fab219",
                  "index": 1
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 30.0001,
                "to": null,
                "result": {
                  "text": "OK",
                  "color": "rgba(138, 138, 138, 0.25)",
                  "index": 2
                }
              }
            }
          ],
          "noValue": "No readings in this time range",
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0,
            "spanNulls": false,
            "insertNulls": false,
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8a8a8a",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "left",
        "rowHeight": 0.8,
        "perPage": 40,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "(min by (sensor, room) (ikea_dirigera_device_battery_percent{room=~\"$room\"})) and on() (time() - max(ikea_dirigera_last_success_timestamp_seconds) < 300)",
          "refId": "A",
          "instant": false,
          "range": true,
          "legendFormat": "{{room}} · {{sensor}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "state-timeline",
      "title": "Connection over time",
      "description": "One row for each device the exporter reads. Yellow: the hub could not reach it. A light switched off at the wall is not reachable.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 37
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
