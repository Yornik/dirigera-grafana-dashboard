                  "index": 0
                },
                "0": {
                  "text": "Not reachable",
                  "color": "#fab219",
                  "index": 1
                }
              }
            }
          ],
          "noValue": "No readings in this time range",
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0,
            "spanNulls": false,
