            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "left",
        "rowHeight": 0.8,
        "perPage": 40,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "(max by (sensor, room) (ikea_dirigera_device_reachable{room=~\"$room\"})) and on() (time() - max(ikea_dirigera_last_success_timestamp_seconds) < 300)",
          "refId": "A",
          "instant": false,
          "range": true,
          "legendFormat": "{{room}} · {{sensor}}"
        }
      ]
    }
